rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /rooms/{room}/chars/{id} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['name','img','t'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 20
        && request.resource.data.img is string && request.resource.data.img.size() < 300000;
      allow delete: if true;
    }
  }
}
